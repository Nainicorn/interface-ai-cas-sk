# Copy to .env and fill in. .env is gitignored and must never be committed.
# Node loads this automatically via --env-file-if-exists in the npm scripts.

# Required for the discovery run (the only part of the system that calls an LLM).
# Replay and the operator console work without it.
ANTHROPIC_API_KEY=

# Credentials for the target application.
#
# These are referenced BY NAME from config/targets.json — the config file stores the
# env var name, never the secret. Nothing here is written to an artifact, a transcript,
# or the database; credentials only ever reach the live browser's cookie jar.
MOCK_BANK_USERNAME=teller01
MOCK_BANK_PASSWORD=demo-password

# Control plane port. The target app runs separately (default 3001).
PORT=3000
