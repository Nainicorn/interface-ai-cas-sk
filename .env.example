# Copy to .env and fill in.

# Required for discovery — the one path that calls a model. Replay, the agent catalog,
# the operator console, and every report work without it.
ANTHROPIC_API_KEY=

# Control plane + console. The app you automate runs wherever it runs; nothing here.
PORT=3000

# App credentials do NOT go here. Each app keeps its own in config/<app>/config.json which are (gitignored)
