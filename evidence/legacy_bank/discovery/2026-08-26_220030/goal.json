{
  "schema_version": 1,
  "id": "lookup-member-full-name",
  "name": "Lookup Member Full Name",
  "version": 1,
  "status": "draft",
  "description": "Logs into the Corevance Core Banking Admin app, searches for a member by numeric member ID, and reads the member's full name from the Member Detail page. Handles the case where the member ID does not exist.",
  "target": {
    "app_id": "legacy_bank",
    "entry_route": "/",
    "tenant_overrides": []
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "member_id": {
        "type": "string",
        "description": "Numeric member identifier to search for",
        "pattern": "^\\d+$"
      }
    },
    "required": [
      "member_id"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "member_full_name": {
        "type": "string",
        "description": "The full name of the member as shown on the Member Detail page"
      }
    },
    "required": [
      "member_full_name"
    ],
    "additionalProperties": false
  },
  "risk_level": "safe",
