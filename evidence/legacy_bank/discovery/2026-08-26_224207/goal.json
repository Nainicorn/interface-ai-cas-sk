      "member_id": {
        "type": "string",
        "description": "Numeric member identifier to search for and open the sub-account under",
        "pattern": "^\\d+$"
      },
      "account_type": {
        "type": "string",
        "description": "Sub-account type to open: Savings, Money Market, or Certificate of Deposit"
      },
      "initial_deposit": {
        "type": "string",
        "description": "Initial deposit amount for the new sub-account (minimum $25.00)"
      }
    },
    "required": [
      "member_id",
      "account_type",
      "initial_deposit"
    ],
    "additionalProperties": false
  },
