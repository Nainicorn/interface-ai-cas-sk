{
  "schema_version": 1,
  "id": "place-account-hold",
  "name": "Place Account Hold (Supervisor)",
  "version": 1,
  "status": "approved",
  "description": "Signs on as a supervisor, locates a member by member number, places a hold on a specified share with a reason code and notes, reviews and posts the hold, and reports the confirmation number and the share held.",
  "target": {
    "app_id": "meridian",
    "entry_route": "/signon",
    "tenant_overrides": []
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "member_number": {
        "type": "string",
        "description": "Member number to search for"
      },
      "share": {
        "type": "string",
        "description": "Share identifier to place on hold (e.g. 101555-S0001)"
      },
      "reason": {
        "type": "string",
        "description": "Reason code label prefix for the hold (e.g. FRAUD)"
      },
      "notes": {
        "type": "string",
        "description": "Free-text notes to record with the hold"
      }
    },
    "required": [
      "member_number",
      "share",
      "reason",
      "notes"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "confirmation_number": {
        "type": "string",
        "description": "Confirmation number issued for the posted hold"
      },
      "held_share": {
        "type": "string",
        "description": "The share number that was placed on hold"
      }
    },
    "required": [
      "confirmation_number",
      "held_share"
    ],
    "additionalProperties": false
  },
