{
  "schema_version": 1,
  "id": "post-funds-transfer",
  "name": "Post Member Funds Transfer",
  "version": 1,
  "status": "approved",
  "description": "Signs on to Meridian Core, locates a member by member number, opens Funds Transfer, fills from-share/to-share/amount/memo, reviews on the Confirm Funds Transfer screen, and posts the transaction. Returns the confirmation number and posted amount. Handles member-not-found and rejected-transaction (e.g. share on HOLD, insufficient funds) as declared business outcomes.",
  "target": {
    "app_id": "meridian",
    "entry_route": "/signon",
    "tenant_overrides": []
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "member_number": {
        "type": "string",
        "description": "Member number to search for and transfer funds within"
      },
      "from_share": {
        "type": "string",
        "description": "Share ID to debit (must match an option in the From Share dropdown)"
      },
      "to_share": {
        "type": "string",
        "description": "Share ID to credit (must match an option in the To Share dropdown)"
      },
      "amount": {
        "type": "string",
        "description": "Dollar amount to transfer, e.g. 1.00"
      },
      "memo": {
        "type": "string",
        "description": "Memo text for the transfer"
      }
    },
    "required": [
      "member_number",
      "from_share",
      "to_share",
      "amount",
      "memo"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "confirmation_number": {
        "type": "string",
        "description": "Confirmation number issued when the transfer posts"
      },
      "posted_amount": {
        "type": "string",
        "description": "Dollar amount that was posted, as shown on the Transfer Posted screen"
      }
    },
    "required": [
      "confirmation_number",
      "posted_amount"
    ],
    "additionalProperties": false
  },
