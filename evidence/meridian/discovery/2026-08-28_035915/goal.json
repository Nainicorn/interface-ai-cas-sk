      "member_number": {
        "type": "string",
        "description": "The member number to search for in Member Inquiry"
      }
    },
    "required": [
      "member_number"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "member_name": {
        "type": "string",
        "description": "The full name of the member (Last, First) as shown on the Member Record page"
      },
      "shares_balances_block": {
        "type": "string",
        "description": "The full Shares/Balances table text listing every share id, type, balance and status for the member"
      }
    },
    "required": [
      "member_name",
      "shares_balances_block"
    ],
    "additionalProperties": false
  },
