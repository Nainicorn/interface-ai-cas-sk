{
  "schema_version": 1,
  "id": "member-inquiry-shares-lookup",
  "name": "Member Inquiry - Shares & Balances Lookup",
  "version": 1,
  "status": "draft",
  "description": "Signs on to Meridian Core, searches Member Inquiry by member number, opens the matching member record, and reports the member's name plus their full Shares/Balances block (share id, type, balance, status for every share). Handles the case where the member number does not exist.",
