      "app_url": {
        "type": "string",
        "description": "Starting URL for the new app (e.g. https://www.zazvata.com)"
      },
      "goal": {
        "type": "string",
        "description": "Plain-English goal for the agent to accomplish on the app (e.g. 'Find a link for demo and launch it.')"
