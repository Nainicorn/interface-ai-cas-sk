{
  "schema_version": 1,
  "id": "get-total-signups",
  "name": "Get Total Signups from App Analytics",
  "version": 1,
  "status": "draft",
  "description": "Logs into edoara via email one-time-code, navigates to Settings, opens the Live user analytics (creator tools) panel, and extracts the total number of users that have signed up.",
  "target": {
    "app_id": "edoara",
    "entry_route": "/",
    "tenant_overrides": []
