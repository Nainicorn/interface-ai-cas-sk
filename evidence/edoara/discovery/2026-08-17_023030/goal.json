  "input_schema": {
    "type": "object",
    "properties": {
      "login_email": {
        "type": "string",
        "description": "Email address used to sign in (owner/creator account required to see analytics)"
      },
      "otp_code": {
        "type": "string",
        "description": "6-digit one-time verification code sent to the email address"
      }
    },
    "required": [
      "login_email",
      "otp_code"
    ],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "total_signups": {
        "type": "string",
        "description": "Total number of users that have signed up, as shown in the Live user analytics panel"
      }
    },
    "required": [
      "total_signups"
    ],
    "additionalProperties": false
  },
