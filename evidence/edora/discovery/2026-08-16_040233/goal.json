{
  "schema_version": 1,
  "id": "login-and-open-study-space",
  "name": "Login with Email and Open Study Space",
  "version": 1,
  "status": "draft",
  "description": "Logs into Edoara using an email address (passwordless code flow) and opens a course's study space (e.g. the SAT course) from the Courses list.",
