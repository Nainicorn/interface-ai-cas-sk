node_modules/
.env
.DS_Store
*.log

# Runtime state. Artifacts and evidence ARE committed (they're deliverables);
# the local database and scratch screenshots are not.
data/*.db
data/*.db-journal
tmp/
data/*.db-wal
data/*.db-shm

# Persona credentials registered at runtime — real logins, never committed.
# (ignore the files, not the directory, so the .example stays re-includable)
data/creds/*
!data/creds/*.example.json
