node_modules/
.env
.DS_Store
*.log

# App configs carry credentials — never committed. The template is committed in
# their place, so a fresh clone still shows the shape.
# (ignore the files, not the directory, so the .example stays re-includable)
apps/*/config.json
!apps/config.example.json

# Runtime state. Evidence IS committed (it's the deliverable); scratch is not.
tmp/
data/

# Generated by `npm run generate` — a snapshot, not source
*.spec.js
